/*
 * AM625 Minimal
 *
 * DT supports loading U-Boot binaries via UART and kernel image,
 * initramfs, and kernel devicetree through SD.
 *
 * Copyright (C) 2021-2024 Texas Instruments Incorporated - https://www.ti.com/
 */
/dts-v1/;

#include "k3-am62x-evc_7k_kpb01_cb-common.dtsi"

#include "k3-timesync-router.h"

/ {
	compatible = "dongyang,am625-evc_7k_kpb01_cb", "dongyang,am625";
	model = "dongyang AM625 evc_7k_kpb01_cb";

    opp-table {
		/* Add 1.4GHz OPP for am625-sk board. Requires VDD_CORE to be at 0.85V */
		opp-1400000000 {
			opp-hz = /bits/ 64 <1400000000>;
			opp-supported-hw = <0x01 0x0004>;
			clock-latency-ns = <6000000>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		/* 2G RAM */
		reg = <0x00000000 0x80000000 0x00000000 0x80000000>;

	};

	vcc_5v0_main: regulator-0 {
		/* Output of TPS56208*/
		bootph-all;
		compatible = "regulator-fixed";
		regulator-name = "vcc_5v0_main";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_3v3_main: regulator-1 {
		/* Output of TPS56208 */
		bootph-all;
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_main";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vcc_3v3_sys: regulator-2 {
		/* output of TPS22965 */
		bootph-all;
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_sys";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_3v3_main>;
		enable-active-high;
		gpio = <&tps65219_gpio 2 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
	};

	vdd_mmc1: regulator-3 {
		/* TPS22918DBVR */
		bootph-all;
		compatible = "regulator-fixed";
		regulator-name = "vdd_mmc1";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		enable-active-high;
		vin-supply = <&vcc_3v3_sys>;
		gpio = <&main_gpio0 0 GPIO_ACTIVE_HIGH>;

	};


	vpp_1v8: regulator-4 {
		/* output of TPS6282518DMQ - SOC J8 VPP pin */
		compatible = "regulator-fixed";
		regulator-name = "vpp_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3_sys>;
		regulator-always-on;
		regulator-boot-on;
		/* gpio = <VPP_LDO_EN > VPP_LDO_EN pin is not connected */
	};
};

&main_pmx0 {


	vdd_sd_dv_pins_default: vdd-sd-dv-default-pins {
		bootph-all;
		pinctrl-single,pins = <
			AM62X_IOPAD(0x07c, PIN_OUTPUT, 7) /* (P25) GPMC0_CLK.GPIO0_31 */
		>;
	};
	mygpio0_pins_default: mygpio0-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0000, PIN_OUTPUT, 7) /* (H24) OSPI0_CLK.GPIO0_0 - MMC1 Power */
			AM62X_IOPAD(0x0008, PIN_OUTPUT, 7) /* (J24) OSPI0_DQS.GPIO0_2 */
			AM62X_IOPAD(0x000c, PIN_OUTPUT, 7) /* (E25) OSPI0_D0.GPIO0_3 */
			AM62X_IOPAD(0x008c, PIN_INPUT, 7) /* (L25) GPMC0_WEn.GPIO0_34 */
			AM62X_IOPAD(0x0094, PIN_INPUT, 7) /* (L25) GPMC0_BE1n.GPIO0_36 */
			AM62X_IOPAD(0x009c, PIN_INPUT, 7) /* (V25) GPMC0_WAIT1.GPIO0_38 */
			AM62X_IOPAD(0x00a4, PIN_INPUT, 7) /* (M22) GPMC0_DIR.GPIO0_40 */
			AM62X_IOPAD(0x00a8, PIN_INPUT, 7) /* (M21) GPMC0_CSn0.GPIO0_41 */
			AM62X_IOPAD(0x00ac, PIN_INPUT, 7) /* (L21) GPMC0_CSn1.GPIO0_42 */
		>;
	};
	mygpio1_pins_default: mygpio1-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x0198, PIN_OUTPUT, 7) /* (A19) MCASP0_AXR2.GPIO1_8 */
			AM62X_IOPAD(0x01a4, PIN_OUTPUT, 7) /* (B20) MCASP0_ACLKX.GPIO1_11 */
		>;
	};
	pmic_irq_pins_default: pmic-irq-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x01f4, PIN_OUTPUT, 7) /* (D16) EXTINTn.GPIO1_31 */
		>;
	};

	vdd_sd_dv_pins_default: vdd-sd-dv-default-pins {
		bootph-all;
		pinctrl-single,pins = <
			AM62X_IOPAD(0x07c, PIN_OUTPUT, 7) /* (P25) GPMC0_CLK.GPIO0_31 */
		>;
	};

	main_i2c0_pins_default: main-i2c0-default-pins {
		pinctrl-single,pins = <
			AM62X_IOPAD(0x1e0, PIN_INPUT_PULLUP, 0) /* (B16/E12) I2C0_SCL */
			AM62X_IOPAD(0x1e4, PIN_INPUT_PULLUP, 0) /* (A16/D14) I2C0_SDA */
		>;
	};


};

&main_gpio0 {
	bootph-all;
	pinctrl-names = "default";
	pinctrl-0 = <&mygpio0_pins_default>;
};

&main_gpio1 {
	bootph-all;
    pinctrl-names = "default";
	pinctrl-0 = <&mygpio1_pins_default>;
};

&sdhci1 {
	vmmc-supply = <&vdd_mmc1>;
	vqmmc-supply = <&ldo1_reg>;
};

&cpsw3g {
	pinctrl-names = "default";
	pinctrl-0 = <&main_rgmii1_pins_default>;

	cpts@3d000 {
		/* MAP HW3_TS_PUSH to GENF1 */
		ti,pps = <2 1>;
	};
};

&cpsw3g_mdio {
	/* Only phy0 is connected on this board */
};

&main_i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&main_i2c0_pins_default>;
	clock-frequency = <400000>;

		tps65219: pmic@30 {
			bootph-all;
			compatible = "ti,tps65219";
			reg = <0x30>;
			buck1-supply = <&vcc_3v3_main>;
			buck2-supply = <&vcc_3v3_main>;
			buck3-supply = <&vcc_3v3_main>;
			ldo1-supply = <&vcc_3v3_main>;
			ldo2-supply = <&buck2_reg>;
			ldo3-supply = <&vcc_3v3_main>;
			ldo4-supply = <&vcc_3v3_main>;

			pinctrl-names = "default";
			pinctrl-0 = <&pmic_irq_pins_default &vdd_sd_dv_pins_default>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 224 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			#interrupt-cells = <1>;

			system-power-controller;
			ti,power-button;

			/* VSEL_SD pin control for LDO1 voltage selection */
			vsel-sd-gpios = <&main_gpio0 31 GPIO_ACTIVE_HIGH>;

			tps65219_gpio: gpio {
				compatible = "ti,tps65219-gpio";
				gpio-controller;
				#gpio-cells = <2>;
			};

		regulators {
			buck1_reg: buck1 {
				regulator-name = "VDD_CORE";
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck2_reg: buck2 {
				regulator-name = "VDD_1V8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck3_reg: buck3 {
				regulator-name = "VDD_1V2";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1_reg: ldo1 {
				/*
				 * VDDSHV_SDIO controlled via VSEL_SD pin (GPIO0_31)
				 * for 3.3V/1.8V switching
				 */
				regulator-name = "VDDSHV_SDIO";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-allow-bypass;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo2_reg: ldo2 {
				regulator-name = "VDDR_CORE2";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo3_reg: ldo3 {
				regulator-name = "VDDA_1V8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4_reg: ldo4 {
				regulator-name = "VDD_2V5";
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <2500000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&fss {
	bootph-all;
};


&timesync_router {
	mux-reg-masks-state = <
		K3_TS_OFFSET(12, 0x0001ffff, 17)
		>;
	status = "okay";
};
